GROQ_API_KEY=your_groq_api_key_here

# Model used for cheap classification tasks (resume/JD validation)
GROQ_CLASSIFIER_MODEL=openai/gpt-oss-20b

# Model used for structured extraction and reasoning (resume/JD parsing, gap analysis)
GROQ_REASONING_MODEL=openai/gpt-oss-120b

# Groq's model lineup changes over time. If you hit a 404 model_not_found
# error, list what's actually available on your account with:
#   curl https://api.groq.com/openai/v1/models -H "Authorization: Bearer $GROQ_API_KEY"

# Optional: gates every route except /health behind HTTP Basic Auth (any
# username, this password). Leave empty for local dev. Set this on any
# public deployment, since a public URL otherwise lets anyone burn your
# Groq quota.
APP_PASSWORD=
